{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "**/*.html", "use": "@vercel/static" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "img/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" },
    { "src": "fonts/**", "use": "@vercel/static" },
    { "src": "*.ico", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    {
      "src": "/",
      "has": [{ "type": "host", "value": "jtcompliance.com.au" }],
      "dest": "/jtcompliance.html"
    },
    {
      "src": "/",
      "has": [{ "type": "host", "value": "www.jtcompliance.com.au" }],
      "dest": "/jtcompliance.html"
    },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}